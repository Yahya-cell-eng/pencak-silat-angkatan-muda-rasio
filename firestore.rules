rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (Allow read and write for PAMUR members and management)
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    // App Settings & Logo Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Articles Collection
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isValidId(articleId);
    }

    // Training Schedules Collection
    match /training_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isValidId(scheduleId);
    }

    // Training Registrations Collection
    match /training_registrations/{registrationId} {
      allow read: if true;
      allow write: if isValidId(registrationId);
    }

    // Branches / Ranting Collection
    match /branches/{branchId} {
      allow read: if true;
      allow write: if isValidId(branchId);
    }

    // Belt Ranks Collection
    match /belt_ranks/{beltId} {
      allow read: if true;
      allow write: if isValidId(beltId);
    }

    // Article Comments Collection
    match /article_comments/{commentId} {
      allow read: if true;
      allow write: if isValidId(commentId);
    }

    // Password Reset Requests Collection (For Admin Verification Flow)
    match /password_reset_requests/{requestId} {
      allow read: if true;
      allow write: if isValidId(requestId);
    }

    // Gallery Photos Collection (Activities Documentation)
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if isValidId(photoId);
    }
  }
}
